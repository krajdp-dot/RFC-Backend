# Rajdeep Fruits OS — Backend API
# Copy this to .env and fill in the values

# Neon PostgreSQL connection
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Authentication
JWT_SECRET="generate-a-strong-random-secret-here"
JWT_EXPIRY="7d"

# CORS — your Vercel frontend URL
FRONTEND_URL="https://rfc-frontend-sigma.vercel.app"

# Server
PORT=3001
NODE_ENV=production

# --- Phase 12: WhatsApp (optional) ---------------------------------------
# Leave every line below unset (or WHATSAPP_PROVIDER unset/"fake") to run
# with FakeWhatsAppProvider — every send is logged, never actually
# delivered, and the rest of the app works normally. Set
# WHATSAPP_PROVIDER=meta_cloud_api with real values below to use the
# actual Meta WhatsApp Business Cloud API. See docs/PHASE-12-WHATSAPP.md
# and PHASE-12-RESTORE.md, "WhatsApp provider setup" for where each of
# these comes from in Meta's dashboard.

# "meta_cloud_api" or "fake" (default if unset)
WHATSAPP_PROVIDER="fake"

# From Meta's App Dashboard > WhatsApp > API Setup — a permanent token
# (the default one shown there expires in 24h; generate a permanent one
# under System Users for anything beyond local testing)
WHATSAPP_ACCESS_TOKEN=""

# From the same API Setup page — identifies which of your business's
# phone numbers sends the message
WHATSAPP_PHONE_NUMBER_ID=""

# From Meta Business Settings > Accounts > WhatsApp Accounts
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# A string YOU choose, entered in both this file and Meta's webhook
# configuration screen when you set the callback URL — proves the GET
# verification request setting up the webhook actually came from you
# configuring it, not someone else guessing your callback URL
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# From App Dashboard > Settings > Basic — signs every webhook POST;
# verifyWebhookSignature() in meta-cloud-api.provider.ts checks every
# incoming webhook against this before processing it
WHATSAPP_APP_SECRET=""

